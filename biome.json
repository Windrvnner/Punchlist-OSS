{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "*.ts",
      "*.json",
      "!tests/fixtures",
      "!package-lock.json",
      "!public/vendor"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "warn",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "noImportantStyles": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noExplicitAny": "warn",
        "noFocusedTests": "off",
        "noDuplicateTestHooks": "off",
        "noControlCharactersInRegex": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
      ],
      "javascript": {
        "globals": ["store", "__peer"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    },
    {
      "includes": [
        "tests/**/*.test.ts",
        "tests/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error",
            "noSkippedTests": "error",
            "noExportsInTest": "off"
          }
        }
      }
    }
  ]
}
