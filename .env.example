# Copy to .env (which git ignores) and put the key after the = sign. Never commit the real key.
# Only live runs use it (npm run e2e:live, npm run desktop:live, npm run ai:check -- claude); every other test and check ignores it.
# Light tests on Haiku 5.5; the full document pipeline with model routing only when asked.
PUNCHLIST_AI_KEY=
